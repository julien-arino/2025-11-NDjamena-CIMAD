\section{Chaînes de Markov à temps continu}
% The section page
\newSectionSlide{FIGS-slides-admin/Gemini_Generated_Image_bla659bla659bla6.jpeg}

\subsection{Chaînes de Markov à temps continu}
\newSubSectionSlide{FIGS-slides-admin/Gemini_Generated_Image_9agynl9agynl9agy.jpeg}
\begin{frame}
    \frametitle{Du temps discret au temps continu}
    \begin{block}{Chaînes de Markov à temps discret (CMTD)}
        Un système transite entre états à des pas de temps fixes et discrets ($n=0, 1, 2, \dots$)
        \begin{itemize}
            \item Le futur dépend uniquement de l'état présent (Propriété de Markov)
            \item Régi par une \textbf{matrice de probabilité de transition} $P$, où $P_{ij}$ est la probabilité de passer de l'état $i$ à $j$ en une étape
        \end{itemize}
    \end{block}
    
    \begin{block}{Chaînes de Markov à temps continu (CMTC)}
        Un système peut transiter entre états à \textbf{n'importe quel moment}
        \begin{itemize}
            \item Le temps passé dans un état est une \textbf{variable aléatoire continue}
            \item Le « temps de séjour » dans tout état $i$ suit une \textbf{distribution exponentielle} paramétrée par un \textit{taux de sortie} $q_i$
            \item Ceci est une conséquence directe de la Propriété de Markov appliquée au temps continu (l'exponentielle est la seule distribution continue qui est « sans mémoire »)
        \end{itemize}
    \end{block}
\end{frame}

\begin{frame}
    \frametitle{Taux de transition}
    Dynamique d'une CMTC définie par des \textbf{taux de transition}, pas des probabilités

    \begin{definition}[Taux de transition]
        Pour deux états $i \neq j$, le taux $q_{ij} \ge 0$ est le taux instantané de transition de l'état $i$ à l'état $j$
        \begin{itemize}
            \item Pour un petit intervalle de temps $\Delta t$, la probabilité de transition de $i$ à $j$ est approximativement $q_{ij} \Delta t$
            \item Le \defword{taux de sortie} total de l'état $i$ est $q_i = \sum_{j \neq i} q_{ij}$
            \item Le temps passé dans l'état $i$ est une variable aléatoire exponentielle $T_i \sim \text{E}(q_i)$
        \end{itemize}
    \end{definition}
\end{frame}
    
\begin{frame}{La matrice génératrice}
    \begin{block}{Matrice génératrice (Matrice Q)}
        Rassembler tous les taux de transition dans une seule matrice $Q$
        \begin{itemize}
            \item Hors diagonale : $Q_{ij} = q_{ij}$ pour $i \neq j$ (Le taux de passage de $i$ à $j$)
            \item Diagonale : $Q_{ii} = -q_i = -\sum_{j \neq i} q_{ij}$. (Le négatif du taux de sortie total de $i$)
        \end{itemize}
        Une propriété clé est que toutes les lignes de $Q$ somment à zéro : $\sum_{j} Q_{ij} = 0$.
    \end{block}
    
\end{frame}


\begin{frame}
    \frametitle{Équations de Kolmogorov}
    Soit $P(t)$ la matrice où $P_{ij}(t) = \mathbb{P}(X(t)=j | X(0)=i)$. Comment $P(t)$ évolue-t-elle dans le temps ?
    \vspace{1em}
    
    \begin{alertblock}{Équations de Kolmogorov progressives}
        Décrit le taux de changement de probabilité de finir dans un état cible $j$
        $$ \frac{d}{dt}P(t) = P(t)Q $$
        Sous forme élémentaire :
        $$ P'_{ij}(t) = \sum_{k} P_{ik}(t) Q_{kj} $$
    \end{alertblock}
\end{frame}

\begin{frame}{Solution de l'ÉKP}
        La solution est l'\textbf{exponentielle matricielle}
        $$ P(t) = e^{tQ} = \sum_{k=0}^{\infty} \frac{(tQ)^k}{k!} $$
        \vfill
        La matrice génératrice $Q$ « génère » l'évolution du processus
\end{frame}


% \begin{frame}
%     \frametitle{The Stationary Distribution}
%     What happens to the process after a long time? Does it settle into an equilibrium?
%     
%     \begin{definition}[Stationary Distribution]
%         A probability distribution $\boldsymbol{\pi} = (\pi_1, \pi_2, \dots)$ is called a \textbf{stationary distribution} if, once the system is in this distribution, it stays in it.
%         $$ \boldsymbol{\pi} P(t) = \boldsymbol{\pi} \quad \text{for all } t \ge 0 $$
%         This implies that the distribution is no longer changing, i.e., $\frac{d}{dt}(\boldsymbol{\pi}P(t)) = \mathbf{0}$.
%     \end{definition}
%     
%     
%     \begin{block}{Finding the Stationary Distribution}
%         If a unique stationary distribution exists, it can be found by solving the system of linear equations:
%         $$ \boldsymbol{\pi} Q = \mathbf{0} $$
%         subject to the constraint that $\pi$ is a probability distribution:
%         $$ \sum_i \pi_i = 1 $$
%         The equation $\boldsymbol{\pi} Q = \mathbf{0}$ represents the "global balance" condition: for each state $j$, the total rate of probability flow into $j$ equals the total rate of probability flow out of $j$.
%     \end{block}
% \end{frame}



\subsection{EDO et CMTC}
% The section page
\newSubSectionSlide{FIGS-slides-admin/Gemini_Generated_Image_5yvymh5yvymh5yvy.jpeg}


\begin{frame}{Convertir votre modèle compartimentale EDO en CMTC}
    Facile comme $\pi$ :)
\vfill
\begin{itemize}
    \item Le modèle compartimentale EDO se concentre sur les flux entrants et sortants des compartiments
    \vfill
    \item Le modèle EDO a autant d'équations qu'il y a de compartiments
    \vfill
    \item Le modèle compartimentale CMTC se concentre sur les transitions
    \vfill
    \item Le modèle CMTC a autant de transitions qu'il y a de flèches entre (ou vers ou depuis) les compartiments
\end{itemize}
\end{frame}


\begin{frame}{EDO vers CMTC : focus sur différents composants}
    \begin{center}
        \begin{tikzpicture}[auto,
            scale=1.2, every node/.style={transform shape},
            cloud/.style={minimum width={width("N-1")+2pt},
            draw, ellipse,fill=red!20}]
            \node[cloud, fill=green!90, double=red] (S) at (0,0) {$S$};
            \node[cloud, draw=none, fill=white] (h4) at (2,0) {};
            \node[cloud, fill=red!90, double=red] (I) at (4,0) {$I$};
            \node[cloud, fill=green!90] (S2) at (6,0) {$S$};
            \node[cloud, fill=red!90] (I2) at (8,0) {$I$};
            %% Flows (ODE)
            \path [line, bend left, very thick, dashed] (S) to node [midway, above] (TextNode) {$-\beta SI$} (h4);
            \path [line, bend left, very thick] (h4) to node [midway, below] (TextNode) {$+\gamma I$} (S);
            \path [line, bend left, very thick] (h4) to node [midway, above] (TextNode) {$+\beta SI$} (I);
            \path [line, bend left, very thick, dashed] (I) to node [midway, below] (TextNode) {$-\gamma I$} (h4);
            %% Flows (CTMC)
            \path [line, bend left, very thick, red] (S2) to node [midway, above, black] (TextNode) {$\beta SI$} (I2);
            \path [line, bend left, very thick, red] (I2) to node [midway, below] (TextNode) {$\gamma I$} (S2);
            %%
            \draw[very thick, dotted] (5,-2) -- (5,2);
            %%
            \node[style=rectangle] at (2,2) {EDO};
            \node[style=rectangle] at (7,2) {CMTC};
            %%
            \node[style=rectangle] (fODE) at (2,-2) {focus};
            \path [line, dotted,red] (fODE) to  (S.south);
            \path [line, dotted,red] (fODE) to  (I.south);
            \node[style=rectangle] (fCTMC) at (6,-2) {focus};
            \path [line, dotted,red] (fCTMC) to (6.75,0.3);
            \path [line, dotted,red] (fCTMC) to  (6.75,-0.475);
        \end{tikzpicture}        
    \end{center}
\end{frame}


\begin{frame}{SIS sans démographie}
    \begin{center}
        \begin{tabular}{cp{3cm}cc}
          \toprule
            Transition & Effet & Poids & Probabilité \\
            \midrule
            $S\to S-1$, $I\to I+1$ & nouvelle infection & $\beta SI$ & $\dfrac{\beta SI}{\beta SI+\gamma I}$ \\
            $S\to S+1$, $I\to I-1$ & rétablissement d'un infectieux & $\gamma I$ & $\dfrac{\gamma I}{\beta SI+\gamma I}$ \\
            \bottomrule
        \end{tabular}
    \end{center}
    \vfill
    Les états sont $S,I$
\end{frame}


\begin{frame}{SIS avec démographie}
    \begin{center}
        \begin{tabular}{p{3cm}p{3cm}cc}
        \toprule
            Transition & Effet & Poids & Probabilité \\
          \midrule
            $S\to S+1$ & naissance d'un susceptible & $b$ & $\frac{b}{b+d(S+I)+\beta SI+\gamma I}$ \\
            $S\to S-1$ & décès d'un susceptible & $dS$ & $\frac{dS}{b+d(S+I)+\beta SI+\gamma I}$ \\
            $S\to S-1$, $I\to I+1$ & nouvelle infection & $\beta SI$ & $\frac{\beta SI}{b+d(S+I)+\beta SI+\gamma I}$ \\
            $I\to I-1$ & décès d'un infectieux & $dI$ & $\frac{dI}{b+d(S+I)+\beta SI+\gamma I}$ \\
            $S\to S+1$, $I\to I-1$ & rétablissement d'un infectieux & $\gamma I$ & $\frac{\gamma I}{b+d(S+I)+\beta SI+\gamma I}$ \\
            \bottomrule
        \end{tabular}
    \end{center}
\vfill
Les états sont $S,I$
\end{frame}


\begin{frame}[fragile]{Modèle de Kermack \& McKendrick}
    \begin{center}
        \begin{tabular}{cp{3cm}cc}
        \toprule
            Transition & Effet & Poids & Probabilité \\
            \midrule
            $S\to S-1$, $I\to I+1$ & nouvelle infection & $\beta SI$ & $\dfrac{\beta SI}{\beta SI+\gamma I}$ \\
            $I\to I-1$, $R\to R+1$ & rétablissement d'un infectieux & $\gamma I$ & $\dfrac{\gamma I}{\beta SI+\gamma I}$ \\
            \bottomrule
        \end{tabular}
    \end{center}
    \vfill
    Les états sont $S,I,R$
\end{frame}


\subsection{Simuler les CMTC (en théorie)}
% The section page
\newSubSectionSlide{FIGS-slides-admin/Gemini_Generated_Image_5yvymh5yvymh5yvy.jpeg}


\begin{frame}{L'algorithme de Gillespie}
    \begin{itemize}
        \item Aussi appelé l'algorithme de simulation stochastique (SSA)
        \vfill
        \item Dérivé en 1976 par Daniel Gillespie
        \vfill
        \item Génère des solutions possibles pour les CMTC
        \vfill
        \item Extrêmement simple, donc vaut la peine d'apprendre à implémenter ; il existe cependant des paquets que vous pouvez utiliser (voir plus tard)
    \end{itemize}
\end{frame}


\begin{frame}{L'algorithme de Gillespie}
Supposons que le système a un état $\mathbf{x}(t)$ avec condition initiale $\mathbf{x}(t_0)=\mathbf{x}_0$ et \emph{fonctions de propension} $a_i$ des réactions élémentaires
\vfill
définir $t\leftarrow t_0$ et $\mathbf{x}(t)\leftarrow \mathbf{x}_0$\\
tant que {$t\leq t_f$}\\
-\qquad $\xi_t\leftarrow \sum_j a_j(\mathbf{x}(t))$\\
-\qquad Tirer $\tau_t$ de $T\thicksim \mathcal{E}(\xi_t)$\\
-\qquad Tirer $\zeta_t$ de $\mathcal{U}([0,1])$\\
-\qquad Trouver $r$, le plus petit entier tel que $\sum_{k=1}^j a_k(\mathbf{x}(t))> \zeta_t\sum_j a_j(\mathbf{x}(t))=\zeta_t\xi_t$\\
-\qquad Effectuer la prochaine réaction (celle indexée $r$)\\
-\qquad $t\leftarrow t+\tau_t$\\    
\end{frame}


\begin{frame}{Tirer aléatoirement d'une distribution exponentielle}
    Si vous n'avez pas de générateur de nombres aléatoires de distribution exponentielle.. Nous voulons $\tau_t$ de $T\thicksim\mathcal{E}(\xi_t)$, c'est-à-dire, $T$ a une fonction de densité de probabilité
    $$
    f(x,\xi_t)=
    \xi_te^{-\xi_t x}\mathbf{1}_{x\geq 0}
    $$
    Utiliser la fonction de distribution cumulative $F(x,\xi_t)=\int_{-\infty}^x f(s,\xi_t)\,ds$
    $$
    F(x,\xi_t)=
    (1-e^{-\xi_t x})\mathbf{1}_{x\geq 0}
    $$
    qui a des valeurs dans $[0,1]$. Donc tirer $\zeta$ de $\mathcal{U}([0,1])$ et résoudre $F(x,\xi_t)=\zeta$ pour $x$
    \begin{align*}
    F(x,\xi_t)=\zeta & \Leftrightarrow 1-e^{-\xi_tx}=\zeta \\
    &\Leftrightarrow e^{-\xi_tx} = 1-\zeta \\
    &\Leftrightarrow \xi_tx = -\ln(1-\zeta) \\
    &\Leftrightarrow \boxed{x = \frac{-\ln(1-\zeta)}{\xi_t}}
    \end{align*}
\end{frame}


\begin{frame}{L'algorithme de Gillespie (modèle SIS avec seulement l'éq. I)}
définir $t\leftarrow t_0$ et $I(t)\leftarrow I(t_0)$\\
tant que {$t\leq t_f$}\\
-\qquad $\xi_t\leftarrow \beta (P^\star-i)i+\gamma i$\\
-\qquad Tirer $\tau_t$ de $T\thicksim \mathcal{E}(\xi_t)$\\
-\qquad $v\leftarrow\left[\beta (P^\star-i)i,\xi_t\right]/\xi_t$\\
-\qquad Tirer $\zeta_t$ de $\mathcal{U}([0,1])$\\
-\qquad Trouver $pos$ tel que $v_{pos-1}\leq\zeta_t\leq v_{pos}$\\
-\qquad selon {$pos$}\\
\qquad\qquad - 1: Nouvelle infection, $I(t+\tau_t)=I(t)+1$ \\
\qquad\qquad - 2: Fin de la période infectieuse, $I(t+\tau_t)=I(t)-1$ \\
- $t\leftarrow t+\tau_t$
\end{frame}


\begin{frame}{Parfois Gillespie tourne mal}
    \begin{itemize}
        \item Rappelons que le temps inter-événements est distribué exponentiellement
        \item Étape critique de l'algorithme de Gillespie :
        \begin{itemize}
            \item $\xi_t\leftarrow$ poids de tous les événements possibles (\emph{propension})
            \item Tirer $\tau_t$ de $T\thicksim \mathcal{E}(\xi_t)$
        \end{itemize}
        \item Donc le temps inter-événements $\tau_t\to 0$ si $\xi_t$ devient très grand pour un certain $t$
        \item Ceci peut causer le ralentissement de la simulation jusqu'à l'arrêt
    \end{itemize}
\end{frame}


\begin{frame}{Exemple : un processus de naissance et de mort}
    \begin{itemize}
        \item Individus nés à un taux \emph{per capita} $b$
        \item Individus meurent à un taux \emph{per capita} $d$
        \item Implémentons cela en utilisant le Gillespie classique
    \end{itemize}
    \vfill
(Voir \href{https://raw.githubusercontent.com/julien-arino/3MC-course-epidemiological-modelling/main/CODE/simulate_birth_death_CTMC.R}{\code{simulate\_birth\_death\_CTMC.R}} sur le dépôt GitHub du cours)
\end{frame}


\begin{frame}{L'algorithme de Gillespie (modèle naissance-mort)}
définir $t\leftarrow t_0$ et $N(t)\leftarrow N(t_0)$\\
tant que {$t\leq t_f$}\\
-\qquad $\xi_t\leftarrow (b+d)N(t)$\\
-\qquad Tirer $\tau_t$ de $T\thicksim \mathcal{E}(\xi_t)$\\
-\qquad $v\leftarrow\left[bN(t),\xi_t\right]/\xi_t$\\
-\qquad Tirer $\zeta_t$ de $\mathcal{U}([0,1])$\\
-\qquad Trouver $pos$ tel que $v_{pos-1}\leq\zeta_t\leq v_{pos}$\\
-\qquad selon {$pos$}\\
\qquad\qquad - 1: Naissance, $N(t+\tau_t)=N(t)+1$ \\
\qquad\qquad - 2: Décès, $N(t+\tau_t)=N(t)-1$ \\
- $t\leftarrow t+\tau_t$    
\end{frame}

\begin{frame}[fragile, allowframebreaks]

<<birth-death-setup>>=
birth_death_CTMC = function(b = 0.01, d = 0.01) {
  t_0 = 0    # Initial time
  N_0 = 100  # Initial population
  
  # Vectors to store time and state. Initialise with initial condition.
  t = t_0
  N = N_0
  
  t_f = 1000  # Final time
  
  # Track the current time and state (could just check last entry in t
  # and N, but will take more operations)
  t_curr = t_0
  N_curr = N_0
  while (t_curr<=t_f) {
    xi_t = (b+d)*N_curr
    if (N_curr == 0) {
      break # Avoid error with rexp when xi_t = 0
    }
    tau_t = rexp(1, rate = xi_t)
    t_curr = t_curr+tau_t
    v = c(b*N_curr, xi_t)/xi_t
    zeta_t = runif(n = 1)
    pos = findInterval(zeta_t, v)+1
    switch(pos,
           { N_curr = N_curr+1},  # Birth
           { N_curr = N_curr-1}) # Death
    N = c(N, N_curr)
    t = c(t, t_curr)
  }
  plot(t, N, type = "l",
       xlab = "Time", ylab = "Population size",
       main = paste("Birth-death CTMC with b =", b, "and d =", d))
}
@

\end{frame}

<<CTMC_birth_death_b0_01_d0_01,include=FALSE>>=
birth_death_CTMC()
@

\maxFrameImage{\Sexpr{fig_chunk('CTMC_birth_death_b0_01_d0_01', 'pdf')}}

<<CTMC_birth_death_b0_01_d0_02,include=FALSE>>=
birth_death_CTMC(b=0.01, d=0.02)
@

\maxFrameImage{\Sexpr{fig_chunk('CTMC_birth_death_b0_01_d0_02', 'pdf')}}

\begin{frame}[fragile]{$b=0.03$ \& $d=0.01$...}
Nous voulons exécuter la fonction avec ces valeurs de paramètres mais je sais à l'avance que cela ne fonctionnera pas bien, donc modifions un peu la fonction. Nous ajoutons un test :
\vfill
\begin{lstlisting}
if (t[length(t)]-t[(length(t)-1)] < 1e-8) {
      # If the time step is too small, stop the simulation
      message("Stopping simulation because time step is too small")
      break
    }
\end{lstlisting}
\vfill
\end{frame}

<<birth-death-setup-2,include=FALSE>>=
birth_death_CTMC = function(b = 0.01, d = 0.01) {
  t_0 = 0    # Initial time
  N_0 = 100  # Initial population
  
  # Vectors to store time and state. Initialise with initial condition.
  t = t_0
  N = N_0
  
  t_f = 1000  # Final time
  
  # Track the current time and state (could just check last entry in t
  # and N, but will take more operations)
  t_curr = t_0
  N_curr = N_0
  while (t_curr<=t_f) {
    xi_t = (b+d)*N_curr
    if (N_curr == 0) {
      break # Avoid error with rexp when xi_t = 0
    }
    tau_t = rexp(1, rate = xi_t)
    t_curr = t_curr+tau_t
    v = c(b*N_curr, xi_t)/xi_t
    zeta_t = runif(n = 1)
    pos = findInterval(zeta_t, v)+1
    switch(pos,
           { N_curr = N_curr+1},  # Birth
           { N_curr = N_curr-1}) # Death
    N = c(N, N_curr)
    t = c(t, t_curr)
    if (t[length(t)]-t[(length(t)-1)] < 1e-8) {
      # If the time step is too small, stop the simulation
      message("Stopping simulation because time step is too small")
      break
    }
  }
  plot(t, N, type = "l",
       xlab = "Time", ylab = "Population size",
       main = paste("Birth-death CTMC with b =", b, "and d =", d))
  return(list(t = t, N = N))
}
@

<<CTMC_birth_death_b0_03_d0_01,include=FALSE>>=
results = birth_death_CTMC(b=0.03, d=0.01)
interevent_time = diff(results$t)
@

