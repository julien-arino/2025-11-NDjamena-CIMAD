\section{Pourquoi incorporer la stochasticité ?}
% The section page
\newSectionSlide{FIGS-slides-admin/Gemini_Generated_Image_tve93ftve93ftve9.jpeg}

\begin{frame}{Au début de la crise COVID-19}
\bbullet 
Je travaillais sous contrat avec l'Agence de la santé publique du Canada sur l'\emph{évaluation du risque d'importation de COVID-19}
\vfill
\bbullet 
Produisais un rapport quotidien avec la liste des pays les plus susceptibles de signaler des cas de COVID-19 ensuite
\vfill
\bbullet
Utilisais des exécutions d'ensemble d'un modèle de métapopulation déterministe global ajusté
\end{frame}

\maxFrameImage{FIGS/covid-cluster}

\begin{frame}
\bbullet Very very long days (18-20 hours, 7 days a week)
\vfill
\bbullet including a lot of time waiting for the ``cluster'' to finish
\vfill
$\implies$ PHAC gave me money for a cluster (yay Threadrippers!!!)
\vfill
$\implies$ Also thought about whether my model was really adequate as our focus switched from thinking about movement on a planetary scale to movement within Canadian provinces
\end{frame}

\begin{frame}{Qu'est-ce qui ne va pas avec les modèles déterministes ?}
\bbullet J'ai souligné hier que le SARS-CoV-2 est une \emph{unique} réalisation d'un processus stochastique
\vfill
\bbullet Les modèles déterministes « opèrent sur des moyennes » sur un grand ($\to\infty$) nombre de réalisations
\vfill
\bbullet Si nous voulons avoir une meilleure idée de ce qui pourrait se passer, pas seulement en moyenne, alors nous devons voir ce qui peut effectivement se passer
\end{frame}

\begin{frame}{Mon nouveau focus -- Introductions}
\bbullet J'ai commencé à penser en particulier aux \defword{introductions} (ou importations) de pathogènes dans de nouvelles populations
\vfill
\bbullet En effet, les introductions sont une étape obligatoire dans la propagation spatiale
\end{frame}

\begin{frame}{Premier élément de preuve}
Dans la vraie vie, les introductions de pathogènes ne suivent pas toujours le schéma
\begin{center}
\{$\R_0<1 \implies \to$ DFE | $\R_0>1 \implies $ épidémie ou $\to$ EEP\} 
\end{center}
\end{frame}

\maxFrameImage{FIGS/Delory_etal-cover}
\maxFrameImage{FIGS/Delory_etal-table}

\begin{frame}{Deuxième élément de preuve}
Le début d'une épidémie peut être extrêmement lent, avec très peu de cas pendant un certain temps
\end{frame}

\maxFrameImage{FIGS/select_Wyoming-Campbell_bars_zoom}

\begin{frame}{Pourquoi ceci est pertinent}
Loin d'être la seule raison, mais à titre d'exemple : le Canada a des communautés éloignées/isolées qui sont vulnérables aux introductions de pathogènes
\end{frame}

\maxFrameImage{FIGS/cities_roads_CAN-MB_detail.png}
\maxFrameImage{FIGS/nutrition-north-canada-eligibility.png}
\maxFrameImage{FIGS/Screenshot from 2024-06-25 14-42-25.png}
\maxFrameImage{FIGS/Screenshot from 2024-06-25 16-56-16.png}

\begin{frame}{Pour les communautés des Premières Nations et Métis}
  \defword{Éloignée} décrit une \textbf{zone géographique} où une communauté est \textbf{située à plus de 350 km} du \textbf{centre de services le plus proche} \textbf{ayant un accès toute l'année} par voies terrestres et/ou maritimes normalement utilisées par tous les temps
  \vfill	
  \defword{Isolée} signifie une \textbf{zone géographique} qui a des \textbf{vols réguliers} et un bon service téléphonique, mais est \textbf{sans accès toute l'année} par voies terrestres et/ou maritimes normalement utilisées par tous les temps
  \vfill
  \defword{Éloignée-Isolée} signifie une \textbf{zone géographique} qui n'a \textbf{ni vols réguliers ni accès toute l'année} par voies terrestres et/ou maritimes qui peuvent être utilisées par tous les temps, indépendamment du niveau de service téléphonique et radio disponible
\end{frame}

\begin{frame}{Pour les communautés inuites}
  Les communautés inuites doivent être appelées \defword{Inuit Nunangat}, et non communautés éloignées et isolées, afin de respecter la langue et la culture uniques des régions inuites, ainsi que les défis communs en matière de déterminants sociaux de la santé, d'accès aux soins et d'infrastructure qui se retrouvent dans toutes les communautés inuites
\end{frame}

\begin{frame}\frametitle{Communautés éloignées du MB}
  \begin{quote}
  Les \defword{communautés éloignées} sont des communautés du Manitoba qui \textbf{n'ont pas d'accès routier permanent} (c'est-à-dire, pas de route praticable en toutes saisons), sont \textbf{à plus de quatre heures de route} d'un hôpital rural important (et d'une unité de dialyse), \textbf{ou ont un accès uniquement par rail ou avion}. Cela inclut Norway House, Lynn Lake, Leaf Rapids, Gillam et Cross Lake. Si la plupart des communautés d'un district sanitaire sont désignées comme « éloignées », l'ensemble du district est désigné comme « éloigné ». Au Manitoba, les districts éloignés comprennent :
  \begin{itemize}
  \item Région sanitaire du Nord : NO23, NO13, NO25, NO16, NO22, NO26, NO28, NO31, et
  \item Région sanitaire Interlake-Est : IE61.
  \end{itemize}
  \end{quote}
  \vfill
  \small
  Chartier M, Dart A, Tangri N, Komenda P, Walld R, Bogdanovic B, Burchill C, Koseva I, McGowan K, Rajotte L. Care of Manitobans Living with Chronic Kidney Disease. Winnipeg, MB.
  Manitoba Centre for Health Policy, December 2015
\end{frame}

\maxFrameImage{FIGS/remote-health-regions.png}

\begin{frame}{Voyages vers/depuis des communautés éloignées ou isolées}
  Comment pensez-vous que cela se compare aux voyages dans les communautés non éloignées/isolées ?
  \vfill
  Temps de résidence (la version écologie lacustre) : temps théorique qu'une molécule d'eau moyenne ou comparable passe dans un lac, considérant l'afflux dans et l'écoulement hors du lac
  \vfill
  Pensez aux temps de résidence dans ces communautés : quel est le temps moyen qu'une personne passe dans une communauté éloignée ou isolée avant de la quitter ?
  \vfill
  Le \defword{temps de résidence dans une localisation} est le nombre total de trajets entrants et sortants d'une localisation sur une durée (1 mois ici) divisé par la population normale dans la localisation 
\end{frame}

\maxFrameImage{FIGS/residence-time-in-airports.png}

\begin{frame}{Le paradoxe des voyages vers/depuis les communautés éloignées/isolées}
Volumes de voyage faibles mais taux de mouvement élevés
\vfill
Les CI sont fortement connectées au(x) centre(s) urbain(s) auxquels elles sont subordonnées
\vfill
Encore renforcé à Winnipeg par la population autochtone urbaine (102 075 ou 12,45\% de la population métropolitaine), ce qui signifie que de nombreux liens familiaux existent
\end{frame}

